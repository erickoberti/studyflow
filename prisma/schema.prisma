generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  activeStudyGuideId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  studyGuides        StudyGuide[]         @relation("StudyGuideOwner")
  activeStudyGuide   StudyGuide?          @relation("ActiveStudyGuide", fields: [activeStudyGuideId], references: [id], onDelete: SetNull)
  disciplines        Discipline[]
  subjects           Subject[]
  cycleEntries       CycleEntry[]
  sessions           StudySession[]
  settings           UserSettings?
  guideSettings      StudyGuideSettings[]
  resetTokens        PasswordResetToken[]
  subjectProgress    SubjectProgress[]
  cycleStates        StudyGuideCycleState[]
  activeStudySessions ActiveStudySession[]
  reviews            ReviewSchedule[]
}

model StudyGuide {
  id          String         @id @default(cuid())
  userId      String
  name        String
  icon        String         @default("book-open")
  color       String         @default("#6366f1")
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation("StudyGuideOwner", fields: [userId], references: [id], onDelete: Cascade)
  activeUsers User[]         @relation("ActiveStudyGuide")
  disciplines   Discipline[]
  subjects      Subject[]
  cycleEntries  CycleEntry[]
  sessions      StudySession[]
  settings      StudyGuideSettings?
  cycleState    StudyGuideCycleState?
  subjectProgress SubjectProgress[]
  activeStudySessions ActiveStudySession[]
  reviews            ReviewSchedule[]

  @@unique([userId, name])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Discipline {
  id        String      @id @default(cuid())
  userId    String
  studyGuideId String?
  name      String
  sortOrder Int?
  category  String?
  active    Boolean     @default(true)
  questionGoal Int      @default(20)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide StudyGuide? @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  subjects  Subject[]
  cycleEntries CycleEntry[]
  activeStudySessions ActiveStudySession[]

  @@unique([userId, studyGuideId, name])
  @@index([userId])
  @@index([studyGuideId])
}

model Subject {
  id            String       @id @default(cuid())
  userId        String
  studyGuideId  String?
  disciplineId  String
  name          String
  weight        Int          @default(1)
  notes         String?
  tecReference  String?
  groupName     String?
  active        Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide    StudyGuide?  @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  discipline    Discipline   @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  cycleEntries  CycleEntry[]
  sessions      StudySession[]
  progress      SubjectProgress?
  activeStudySessions ActiveStudySession[]
  reviews            ReviewSchedule[]

  @@index([userId])
  @@index([studyGuideId])
  @@index([disciplineId])
  @@unique([userId, studyGuideId, disciplineId, name])
}

model CycleEntry {
  id         String         @id @default(cuid())
  userId     String
  studyGuideId String?
  subjectId  String?
  disciplineId String?
  orderIndex Int
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide StudyGuide?    @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  subject    Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  discipline Discipline?    @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  sessions   StudySession[]
  activeStudySessions ActiveStudySession[]

  @@index([userId])
  @@index([studyGuideId])
  @@index([subjectId])
  @@index([disciplineId])
  @@unique([userId, studyGuideId, orderIndex])
}

model StudySession {
  id           String    @id @default(cuid())
  userId       String
  studyGuideId String?
  cycleEntryId String
  subjectId    String?
  cyclePosition Int?
  cycleRound    Int?
  date         DateTime
  questions    Int
  correct      Int
  wrong        Int
  percentage   Float
  estimatedMinutes Int @default(0)
  notes        String?
  activeStudySessionId String? @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide   StudyGuide? @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  cycleEntry   CycleEntry @relation(fields: [cycleEntryId], references: [id], onDelete: Cascade)
  subject      Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  activeStudySession ActiveStudySession? @relation("CompletedActiveStudySession", fields: [activeStudySessionId], references: [id], onDelete: SetNull)
  reviews            ReviewSchedule[]

  @@index([userId])
  @@index([studyGuideId])
  @@index([date])
  @@index([cycleEntryId])
  @@index([subjectId])
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  targetPercentage    Float    @default(80)
  dailyQuestionsGoal  Int      @default(30)
  weeklyQuestionsGoal Int      @default(200)
  weightPriorityBias  Float    @default(1.25)
  theme               String   @default("system")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyGuideSettings {
  id                  String     @id @default(cuid())
  userId              String
  studyGuideId        String     @unique
  targetPercentage    Float      @default(80)
  dailyQuestionsGoal  Int        @default(30)
  weeklyQuestionsGoal Int        @default(200)
  weightPriorityBias  Float      @default(1.25)
  organizer           String?
  role                String?
  examDate            DateTime?
  sessionMinutes      Int        @default(60)
  questionsPerSession Int        @default(20)
  cycleAlgorithm      String     @default("weighted_round_robin")
  aiEnabled           Boolean    @default(false)
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide          StudyGuide @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)

  @@unique([userId, studyGuideId])
  @@index([userId])
}

model StudyGuideCycleState {
  id                String     @id @default(cuid())
  userId            String
  studyGuideId      String     @unique
  currentOrderIndex Int        @default(1)
  roundNumber       Int        @default(1)
  version           Int        @default(1)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide        StudyGuide @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum StudySessionMode {
  CYCLE
  AVULSO
}

enum ActiveStudySessionStatus {
  ACTIVE
  PAUSED
  FINISHING
  FINISHED
  CANCELLED
}

model ActiveStudySession {
  id                 String                   @id @default(cuid())
  userId             String
  studyGuideId       String
  cycleEntryId       String?
  disciplineId       String
  subjectId          String
  mode               StudySessionMode
  status             ActiveStudySessionStatus @default(ACTIVE)
  startedAt          DateTime                 @default(now())
  accumulatedSeconds Int                      @default(0)
  pausedAt           DateTime?
  version            Int                      @default(1)
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide         StudyGuide               @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  cycleEntry         CycleEntry?              @relation(fields: [cycleEntryId], references: [id], onDelete: SetNull)
  discipline         Discipline                @relation(fields: [disciplineId], references: [id], onDelete: Cascade)
  subject            Subject                   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  completedSession   StudySession?             @relation("CompletedActiveStudySession")

  @@index([userId, studyGuideId, status])
  @@index([studyGuideId])
}

enum ReviewStatus {
  PENDING
  COMPLETED
  DISMISSED
}

model ReviewSchedule {
  id           String       @id @default(cuid())
  userId       String
  studyGuideId String
  subjectId    String
  sourceSessionId String?
  dueAt        DateTime
  intervalDays Int
  status       ReviewStatus @default(PENDING)
  completedAt  DateTime?
  dismissedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide   StudyGuide   @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sourceSession StudySession? @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)

  @@index([userId, studyGuideId, status, dueAt])
  @@index([subjectId])
  @@index([sourceSessionId])
}

model SubjectProgress {
  id              String   @id @default(cuid())
  userId          String
  studyGuideId    String
  subjectId       String   @unique
  currentWeight   Int      @default(0)
  passages        Int      @default(0)
  totalQuestions  Int      @default(0)
  correct         Int      @default(0)
  wrong           Int      @default(0)
  averagePercentage Float  @default(0)
  lastStudiedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyGuide      StudyGuide @relation(fields: [studyGuideId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, studyGuideId])
}

model GoalDefinition {
  id          String   @id
  code        String   @unique
  title       String
  description String?
  metric      String
  targetValue Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([metric, active])
}


